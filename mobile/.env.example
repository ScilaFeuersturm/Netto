# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Dashboard → Connect). La clave pública (publishable/anon) está pensada para ir en la app:
# la seguridad la dan las políticas RLS del servidor. Nunca poner acá la clave secreta/service_role.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
